# Never commit a populated .env file. Configure production values with
# `supabase secrets set --env-file ...` after the Safaricom/PSP agreement exists.
APP_ORIGINS=http://localhost:3000
CRON_SECRET=replace-with-32-or-more-random-characters

MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://PROJECT_REF.supabase.co/functions/v1/mpesa-callback
MPESA_CALLBACK_TOKEN=replace-with-32-or-more-random-characters

MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
# Generate this from the official Safaricom certificate; never store the raw
# initiator password in source control.
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_B2C_RESULT_URL=https://PROJECT_REF.supabase.co/functions/v1/mpesa-b2c-callback
MPESA_B2C_TIMEOUT_URL=https://PROJECT_REF.supabase.co/functions/v1/mpesa-b2c-callback
MPESA_B2C_CALLBACK_TOKEN=replace-with-32-or-more-random-characters

# Refunds use a separate callback secret and endpoint so a provider result
# cannot be confused with a driver payout result.
MPESA_REFUND_COMMAND_ID=BusinessPayment
MPESA_REFUND_RESULT_URL=https://PROJECT_REF.supabase.co/functions/v1/mpesa-refund-callback
MPESA_REFUND_TIMEOUT_URL=https://PROJECT_REF.supabase.co/functions/v1/mpesa-refund-callback
MPESA_REFUND_CALLBACK_TOKEN=replace-with-32-or-more-random-characters

# Optional adapter for push/SMS/email/WhatsApp delivery. In-app notifications
# work without this webhook.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
